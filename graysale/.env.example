# GraySale backend environment variables.
#
# The app does NOT load .env files (zero runtime dependencies) — export these
# in your shell, systemd `EnvironmentFile=`, or process manager before
# `npm start`. Every value below is optional; defaults are shown.

# ---------- core ----------
PORT=3030
NODE_ENV=development
# DB_PATH=C:/data/graysale.db          # default: graysale/src/data/graysale.db
SESSION_TTL_MS=43200000                # login session lifetime (12h default, min 60000)

# ---------- logging ----------
# LOG_REQUESTS=1                       # per-request log lines; set 0 to silence

# ---------- backups (SQLite VACUUM INTO snapshots, rotating) ----------
# BACKUP_DIR=C:/backups                # default: <data folder>/backups
BACKUP_KEEP=7                          # snapshots to keep (1-365)
BACKUP_INTERVAL_HOURS=24               # how often to snapshot (1-720)

# ---------- optional TLS (set both or neither) ----------
# TLS_CERT=C:/certs/fullchain.pem
# TLS_KEY=C:/certs/privkey.pem

# ---------- EcoCash sandbox credentials (only needed for npm test) ----------
# ECOCASH_SANDBOX_USERNAME=
# ECOCASH_SANDBOX_PASSWORD=
# ECOCASH_SANDBOX_MERCHANT_CODE=
