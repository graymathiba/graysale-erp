# Node artifacts
node_modules/
dist/
.grunt
.env
*.log
.DS_Store

# Built web bundles
/public/dist/
/graysale/web/dist/

# SQLite runtime artifacts (schema.js re-seeds a fresh DB on first run,
# so the local .db is disposable state, not source)
*.db
*.db-wal
*.db-shm

# PID / ad-hoc run artifacts
pid.txt
*.out.txt
*.err.txt

# Lint output
eslint-report.json

# Portable-storage descriptor: machine-specific (absolute paths + machine
# fingerprint). Each install writes its own on first run.
graysale/src/data/storage.json

# Backup snapshots (live next to the database)
graysale/src/data/backups/

# Local dev logs (some were tracked pre-gitignore; untracked going forward)
graysale/server.log
graysale/server.out.log
graysale/server.err.log
graysale/server.run.log
graysale/server.run.err.log
graysale/web/vite-dev.log
graysale/web/vite-dev.err.log